{
  "openapi": "3.0.3",
  "info": {
    "title": "nodejs-129",
    "version": "1.0.0",
    "description": "Express REST API for students. The app stores data in MongoDB with Mongoose.\n\nThe app validates requests with celebrate and Joi. A request that fails validation returns `400`.\n\nThe app uses cookie sessions. `POST /auth/register`, `POST /auth/login`, and `POST /auth/refresh` set three cookies: `accessToken` (15 minutes), `refreshToken` (24 hours), and `sessionId` (24 hours). All cookies are `HttpOnly`, `Secure`, and `SameSite=None`. All `/students` endpoints require the `accessToken` and `sessionId` cookies. Each user sees and changes only the students that the user created. When the access token expires, call `POST /auth/refresh`.\n\nAny method and path that the app does not define returns `404` with the body `{ \"msg\": \"Route not found!\" }`. Exception: the authentication middleware runs for each path that starts with `/students`, so an unknown path such as `/students/a/b` without valid cookies returns `401`."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [],
  "tags": [
    {
      "name": "auth",
      "description": "User registration, login, logout, and session refresh with cookies."
    },
    {
      "name": "students",
      "description": "Student resources stored in MongoDB."
    }
  ],
  "paths": {
    "/auth/register": {
      "post": {
        "tags": ["auth"],
        "operationId": "registerUser",
        "summary": "Register a user",
        "description": "Creates a user, creates a session, and sets the session cookies. Returns the new user. The app stores a bcrypt hash of the password and does not return it. If you do not send `username`, the app sets it to `email`.",
        "security": [],
        "requestBody": {
          "required": true,
          "description": "`express.json()` parses the body and returns `500` for malformed JSON.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterUserBody"
              },
              "example": {
                "email": "olfa@example.com",
                "password": "secret123"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The new user. The response sets the session cookies.",
            "headers": {
              "Set-Cookie": {
                "$ref": "#/components/headers/SetSessionCookies"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "description": "The request failed celebrate validation, or a user with this email already exists.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ValidationError"
                    },
                    {
                      "$ref": "#/components/schemas/ErrorResponse"
                    }
                  ]
                },
                "examples": {
                  "validation": {
                    "summary": "Validation failed",
                    "value": {
                      "statusCode": 400,
                      "error": "Bad Request",
                      "message": "Validation failed",
                      "validation": {
                        "body": {
                          "source": "body",
                          "keys": ["password"],
                          "message": "\"password\" length must be at least 8 characters long"
                        }
                      }
                    }
                  },
                  "emailInUse": {
                    "summary": "Email in use",
                    "value": {
                      "message": "Email in use"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["auth"],
        "operationId": "loginUser",
        "summary": "Log in a user",
        "description": "Checks the email and password. Deletes one existing session of the user, creates a new session, and sets the session cookies. Returns the user.",
        "security": [],
        "requestBody": {
          "required": true,
          "description": "`express.json()` parses the body and returns `500` for malformed JSON.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginUserBody"
              },
              "example": {
                "email": "olfa@example.com",
                "password": "secret123"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The user. The response sets the session cookies.",
            "headers": {
              "Set-Cookie": {
                "$ref": "#/components/headers/SetSessionCookies"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "description": "No user has this email, or the password is incorrect.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "message": "Invalid credentials"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": ["auth"],
        "operationId": "logoutUser",
        "summary": "Log out a user",
        "description": "Deletes the session from the `sessionId` cookie, if the cookie is present, and clears the `accessToken`, `refreshToken`, and `sessionId` cookies. Always returns `204`, also without cookies.",
        "security": [],
        "parameters": [
          {
            "$ref": "#/components/parameters/SessionIdCookie"
          }
        ],
        "responses": {
          "204": {
            "description": "The session is deleted. No body.",
            "headers": {
              "Set-Cookie": {
                "$ref": "#/components/headers/ClearSessionCookies"
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": ["auth"],
        "operationId": "refreshSession",
        "summary": "Refresh the session",
        "description": "Finds the session from the `sessionId` and `refreshToken` cookies. If the refresh token is valid, deletes the old session, creates a new session, and sets new session cookies. If the refresh token expired, deletes the session and clears the cookies.",
        "security": [],
        "parameters": [
          {
            "$ref": "#/components/parameters/SessionIdCookie"
          },
          {
            "name": "refreshToken",
            "in": "cookie",
            "required": true,
            "description": "The refresh token of the session.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The session is refreshed. The response sets new session cookies.",
            "headers": {
              "Set-Cookie": {
                "$ref": "#/components/headers/SetSessionCookies"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefreshResponse"
                },
                "example": {
                  "messages": "Session refresh success!"
                }
              }
            }
          },
          "401": {
            "description": "A cookie is missing (`No session creds`), no session matches the cookies (`Bad session`), or the refresh token expired (`Session token expired`). For an expired token, the response also clears the session cookies.",
            "headers": {
              "Set-Cookie": {
                "$ref": "#/components/headers/ClearSessionCookies"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "noCreds": {
                    "summary": "A cookie is missing",
                    "value": {
                      "message": "No session creds"
                    }
                  },
                  "badSession": {
                    "summary": "No session matches the cookies",
                    "value": {
                      "message": "Bad session"
                    }
                  },
                  "expired": {
                    "summary": "The refresh token expired",
                    "value": {
                      "message": "Session token expired"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/students": {
      "get": {
        "tags": ["students"],
        "operationId": "getStudents",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "summary": "Get a page of students",
        "description": "Returns one page of the students of the current user. You can filter and sort the list.\n\nAll filters apply together. `totalItems` and `totalPages` count only the students that match the filters. If `page` is more than `totalPages`, `students` is an empty array.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "The page number.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "perPage",
            "in": "query",
            "required": false,
            "description": "The number of students on one page.",
            "schema": {
              "type": "integer",
              "minimum": 5,
              "maximum": 20,
              "default": 5
            }
          },
          {
            "name": "minAvgMark",
            "in": "query",
            "required": false,
            "description": "Return only students with `avgMark` greater than or equal to this value. The value must be more than `0`.",
            "schema": {
              "type": "number",
              "exclusiveMinimum": true,
              "minimum": 0
            }
          },
          {
            "name": "studentGender",
            "in": "query",
            "required": false,
            "description": "Return only students with this `gender`.",
            "schema": {
              "type": "string",
              "enum": ["male", "female", "other"]
            }
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "description": "Return only students whose `name` contains this text. The search is not case-sensitive. Regular expression characters are escaped, so they match as plain text. The app trims spaces at the start and the end. An empty value matches all students.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sortBy",
            "in": "query",
            "required": false,
            "description": "The field to sort by. If you do not send it, the list is sorted by `_id`.",
            "schema": {
              "type": "string",
              "enum": ["name", "age", "avgMark", "createdAt"]
            }
          },
          {
            "name": "sortOrder",
            "in": "query",
            "required": false,
            "description": "The sort direction.",
            "schema": {
              "type": "string",
              "enum": ["asc", "desc"],
              "default": "asc"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One page of students and the totals for the filtered list.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StudentsPage"
                },
                "example": {
                  "totalItems": 12,
                  "totalPages": 3,
                  "students": [
                    {
                      "_id": "6740b1f2c3a4d5e6f7a8b9c0",
                      "name": "Olfa Kovalenko",
                      "age": 21,
                      "gender": "female",
                      "avgMark": 10.5,
                      "onDuty": false,
                      "userId": "6740a0e1b2c3d4e5f6a7b8c9",
                      "createdAt": "2026-11-18T10:00:00.000Z",
                      "updatedAt": "2026-11-18T10:00:00.000Z",
                      "__v": 0
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "post": {
        "tags": ["students"],
        "operationId": "createStudent",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "summary": "Create a student",
        "description": "Creates a student in the database and returns the new student. The app sets `userId` to the ID of the current user.",
        "requestBody": {
          "required": true,
          "description": "`express.json()` parses the body and returns `500` for malformed JSON.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateStudentBody"
              },
              "example": {
                "name": "Olfa Kovalenko",
                "age": 21,
                "gender": "female",
                "avgMark": 10.5
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The new student.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Student"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "delete": {
        "tags": ["students"],
        "operationId": "deleteStudents",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "summary": "Delete many students by IDs",
        "description": "Deletes all students whose `_id` is in the `id` query parameter. Repeat the parameter for each ID: `?id=a&id=b`. IDs that do not exist, and IDs of students of other users, are not an error. The app does not delete them and does not count them.",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "Student IDs (MongoDB ObjectId). Repeat the parameter for each ID.",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The number of deleted students. Can be `0`.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["deletedCount"],
                  "properties": {
                    "deletedCount": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                },
                "example": {
                  "deletedCount": 2
                }
              }
            }
          },
          "400": {
            "description": "No `id` parameter, or an `id` is not a valid ObjectId.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                },
                "example": {
                  "statusCode": 400,
                  "error": "Bad Request",
                  "message": "Validation failed",
                  "validation": {
                    "query": {
                      "source": "query",
                      "keys": ["id"],
                      "message": "\"id\" is required"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/students/{studentId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/StudentId"
        }
      ],
      "get": {
        "tags": ["students"],
        "operationId": "getStudentById",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "summary": "Get a student by ID",
        "description": "Returns the student with this ID. The student must belong to the current user.",
        "responses": {
          "200": {
            "$ref": "#/components/responses/StudentResponse"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/StudentNotFound"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "patch": {
        "tags": ["students"],
        "operationId": "updateStudent",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "summary": "Update a student",
        "description": "Changes the fields of the student that are in the request body. Returns the student after the update. The student must belong to the current user.",
        "requestBody": {
          "required": true,
          "description": "At least one field. `express.json()` parses the body and returns `500` for malformed JSON.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateStudentBody"
              },
              "example": {
                "avgMark": 11
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/StudentResponse"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/StudentNotFound"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "delete": {
        "tags": ["students"],
        "operationId": "deleteStudent",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "summary": "Delete a student",
        "description": "Deletes the student with this ID. Returns the deleted student. The student must belong to the current user.",
        "responses": {
          "200": {
            "$ref": "#/components/responses/StudentResponse"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/StudentNotFound"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "accessToken",
        "description": "The access token from the `accessToken` cookie. The authentication middleware also requires the `sessionId` cookie. The access token is valid for 15 minutes. Swagger UI \"Try it out\" does not support cookie authentication."
      }
    },
    "parameters": {
      "SessionIdCookie": {
        "name": "sessionId",
        "in": "cookie",
        "required": false,
        "description": "The session ID (MongoDB ObjectId).",
        "schema": {
          "type": "string"
        }
      },
      "StudentId": {
        "name": "studentId",
        "in": "path",
        "required": true,
        "description": "The student ID. It must be a valid MongoDB ObjectId.",
        "schema": {
          "type": "string"
        }
      }
    },
    "headers": {
      "SetSessionCookies": {
        "description": "Sets three cookies: `accessToken` (`Max-Age` 15 minutes), `refreshToken` (`Max-Age` 24 hours), and `sessionId` (`Max-Age` 24 hours). Each cookie has `HttpOnly`, `Secure`, and `SameSite=None`.",
        "schema": {
          "type": "string"
        },
        "example": "accessToken=0b1c2d3e-4f50-4a6b-8c7d-9e0f1a2b3c4d; Max-Age=900; Path=/; HttpOnly; Secure; SameSite=None"
      },
      "ClearSessionCookies": {
        "description": "Clears the `accessToken`, `refreshToken`, and `sessionId` cookies.",
        "schema": {
          "type": "string"
        },
        "example": "accessToken=; Path=/; Expires=Thu, 01 Jan 1970 00:00:00 GMT"
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "The `accessToken` or `sessionId` cookie is missing, no session matches the cookies, the access token expired, or the user of the session does not exist. The authentication middleware runs before validation, so this response comes before `400`.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "message": "Bad session"
            }
          }
        }
      },
      "StudentResponse": {
        "description": "The student.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Student"
            }
          }
        }
      },
      "BadRequest": {
        "description": "The request failed celebrate validation.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "example": {
              "statusCode": 400,
              "error": "Bad Request",
              "message": "Validation failed",
              "validation": {
                "query": {
                  "source": "query",
                  "keys": ["perPage"],
                  "message": "\"perPage\" must be less than or equal to 20"
                }
              }
            }
          }
        }
      },
      "StudentNotFound": {
        "description": "No student of the current user has this ID.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "message": "Student not found"
            }
          }
        }
      },
      "InternalServerError": {
        "description": "An error from the app-level error handler that is not an `http-errors` error, for example a body parser error or a database error.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "message": "Oops something went wrong!"
            }
          }
        }
      }
    },
    "schemas": {
      "Student": {
        "type": "object",
        "required": [
          "_id",
          "name",
          "age",
          "gender",
          "avgMark",
          "onDuty",
          "userId",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "_id": {
            "type": "string",
            "description": "MongoDB ObjectId."
          },
          "name": {
            "type": "string"
          },
          "age": {
            "type": "number"
          },
          "gender": {
            "type": "string",
            "enum": ["male", "female", "other"]
          },
          "avgMark": {
            "type": "number"
          },
          "onDuty": {
            "type": "boolean",
            "default": false
          },
          "userId": {
            "type": "string",
            "description": "The ID (MongoDB ObjectId) of the user that created the student."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "__v": {
            "type": "integer",
            "description": "Mongoose version key. Documents that were not created with Mongoose, for example seed data, do not have it."
          }
        }
      },
      "StudentsPage": {
        "type": "object",
        "required": ["totalItems", "totalPages", "students"],
        "properties": {
          "totalItems": {
            "type": "integer",
            "minimum": 0,
            "description": "The number of students that match the filters."
          },
          "totalPages": {
            "type": "integer",
            "minimum": 0,
            "description": "The number of pages for `perPage`. `0` if no students match."
          },
          "students": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Student"
            }
          }
        },
        "additionalProperties": false
      },
      "CreateStudentBody": {
        "type": "object",
        "required": ["name", "age", "gender", "avgMark"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 50
          },
          "age": {
            "type": "integer",
            "minimum": 10,
            "maximum": 80
          },
          "gender": {
            "type": "string",
            "enum": ["male", "female", "other"]
          },
          "avgMark": {
            "type": "number",
            "minimum": 2,
            "maximum": 15
          },
          "onDuty": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "UpdateStudentBody": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 50
          },
          "age": {
            "type": "integer",
            "minimum": 10,
            "maximum": 80
          },
          "gender": {
            "type": "string",
            "enum": ["male", "female", "other"]
          },
          "avgMark": {
            "type": "number",
            "minimum": 2,
            "maximum": 15
          },
          "onDuty": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "User": {
        "type": "object",
        "required": ["_id", "username", "email", "createdAt", "updatedAt"],
        "description": "A user. The app does not return the password hash.",
        "properties": {
          "_id": {
            "type": "string",
            "description": "MongoDB ObjectId."
          },
          "username": {
            "type": "string",
            "description": "The app sets it to `email` when the user is created."
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "__v": {
            "type": "integer",
            "description": "Mongoose version key."
          }
        }
      },
      "RegisterUserBody": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 30
          }
        },
        "additionalProperties": false
      },
      "LoginUserBody": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "RefreshResponse": {
        "type": "object",
        "required": ["messages"],
        "properties": {
          "messages": {
            "type": "string",
            "description": "The key is `messages`, not `message`."
          }
        },
        "additionalProperties": false
      },
      "ValidationError": {
        "type": "object",
        "required": ["statusCode", "error", "message", "validation"],
        "properties": {
          "statusCode": {
            "type": "integer",
            "enum": [400]
          },
          "error": {
            "type": "string",
            "example": "Bad Request"
          },
          "message": {
            "type": "string",
            "example": "Validation failed"
          },
          "validation": {
            "type": "object",
            "description": "One key for the request segment that failed: `query`, `params`, or `body`.",
            "additionalProperties": {
              "type": "object",
              "required": ["source", "keys", "message"],
              "properties": {
                "source": {
                  "type": "string",
                  "enum": ["query", "params", "body"]
                },
                "keys": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "The paths of the invalid fields."
                },
                "message": {
                  "type": "string",
                  "description": "The Joi error message."
                }
              }
            }
          }
        },
        "additionalProperties": false
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "message": {
            "type": "string",
            "description": "For an `http-errors` error, the error message, for example `Student not found`. For other errors: `Oops something went wrong!` if `NODE_ENV` is `production`, and the error stack trace in all other cases."
          }
        },
        "additionalProperties": false
      }
    }
  }
}
